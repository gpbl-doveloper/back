generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TODO: sqlite does not support ENUM => postgresql 로 migrate
// enum Role {
//   PARENT
//   TEACHER
//   DIRECTOR
// }
// enum Sex{
//   FEMALE 
//   MALE
// }

model User {
  id        Int      @id @default(autoincrement())
  uid       String   @unique // firebase uid
  name      String
  role      String   @default("PARENT") // PARENT, TEACHER, DIRECTOR
  phone     String?
  email     String   @unique
  createdAt DateTime @default(now())

  authoredDiaries Diary[] @relation("DiaryAuthorRelation")
  dogs            Dog[] @relation("DogOwnerRelation")

  // 1대1 관계: Owner 관계
  ownedCenter Center? @relation("CenterOwnerRelation")

  // 일대다 관계: Employee 관계
  center      Center? @relation("CenterUserRelation", fields: [centerId], references: [id])
  centerId    Int?
}


model Center {
  id        Int      @id @default(autoincrement())
  name      String  
  phone     String? 
  description String @default("")
  createdAt DateTime @default(now())
  
  owner     User   @relation("CenterOwnerRelation", fields: [ownerId], references: [id]) 
  ownerId   Int    @unique 

  diarys    Diary[] @relation("DiaryCenterRelation")
  employees User[]  @relation("CenterUserRelation") 
  files     File[]  @relation("CenterFileRelation")
}

model Dog {
  id         Int      @id @default(autoincrement())
  name       String
  img        String
  sex        String
  isNeutered Boolean
  bod        DateTime
  breed      String?
  medicine   MedicineRequest[] @relation("MRDogRelation")

  owner   User @relation("DogOwnerRelation", fields: [ownerId], references: [id])
  ownerId Int

  diarys     Diary[] @relation("DiaryDogRelation")
  facefiles  File[]  @relation("facefileRelation")
  reservations Reservation[] @relation("ReservationDogRelation")
}

model Diary {
  id        Int      @id @default(autoincrement())
  activities   String @default("")
  createdAt DateTime @default(now())
  feedingTime   Int @default(1) // 1 - 3
  feedingAmt    String @default("All") // All, Some, Nothing 
  napStart  DateTime?
  napEnd    DateTime?
  note      String @default("")

  author   User? @relation("DiaryAuthorRelation", fields: [authorId], references: [id])
  authorId Int?
  dog      Dog?  @relation("DiaryDogRelation", fields: [dogId], references: [id])
  dogId    Int?
  center   Center?  @relation("DiaryCenterRelation", fields: [centerId], references: [id])
  centerId    Int?

  pictures File[]
}

model File {
  id        Int      @id @default(autoincrement())
  fileKey   String   @unique
  fileURL   String
  createdAt DateTime @default(now())
  
  center    Center?  @relation("CenterFileRelation", fields: [dogId], references: [id])
  centerId  Int?
  diary   Diary? @relation(fields: [diaryId], references: [id])
  diaryId Int?
  dog       Dog? @relation("facefileRelation", fields: [dogId], references: [id])
  dogId     Int?
}

model MedicineRequest {
  id       Int               @id @default(autoincrement())
  note     String
  expireAt DateTime          @default(now())
  records  MedicineRecord[]  
  dog      Dog               @relation("MRDogRelation", fields: [dogId], references: [id])
  dogId    Int               
}

model MedicineRecord {
  id          Int              @id @default(autoincrement())
  requestId   Int              
  request     MedicineRequest   @relation(fields: [requestId], references: [id])
  createdAt   DateTime         @default(now())
}


// enum ReservationStatus {
//   PENDDING
//   ACCEPTED
//   REJECTED
// }
model Reservation{
  id     Int              @id @default(autoincrement())
  dog    Dog @relation("ReservationDogRelation",fields: [dogId], references: [id])
  dogId  Int
  date   DateTime @default(now())
  status String   @default("PENDDING")
  createdAt   DateTime         @default(now())
}