generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TODO: sqlite does not support ENUM => postgresql 로 migrate
// enum Role {
//   PARENT
//   CENTER
// }
// enum Sex{
//   FEMALE 
//   MALE
// }

model User {
  id        Int      @id @default(autoincrement())
  uid       String   @unique // firebase uid
  name      String
  role      String   @default("PARENT") // PARENT, CENTER
  phone     String?
  email     String   @unique
  createdAt DateTime @default(now())

  // for center user  
  center   Center? @relation("CenterUserRelation", fields: [centerId], references: [id])
  centerId Int?    @unique
  // for parent user
  dogs     Dog[]   @relation("DogOwnerRelation")
}

model Center {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String   @default("")
  description String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())

  user   User?  @relation("CenterUserRelation")

  diaryNotes  DiaryNote[]  @relation("DiaryNoteCenterRelation")
  diaryPhotos DiaryPhoto[] @relation("DiaryPhotoCenterRelation")

  reservations Reservation[] @relation("ReservationCenterRelation")

  files File[] @relation("CenterFileRelation") // for photo upload
}

model Dog {
  id         Int      @id @default(autoincrement())
  img        String   @default("") // img url
  name       String
  sex        String
  isNeutered Boolean
  bod        DateTime
  breed      String   @default("")
  medication String   @default("")

  lastNoteAt DateTime?
  lastPicsAt DateTime?

  owner   User @relation("DogOwnerRelation", fields: [ownerId], references: [id])
  ownerId Int

  diaryNotes   DiaryNote[]   @relation("DiaryNoteDogRelation")
  diaryPhotos  DiaryPhoto[]  @relation("DiaryPhotoDogRelation")
  facefiles    File[]        @relation("FacefileRelation")
  reservations Reservation[] @relation("ReservationDogRelation")
}

model DiaryNote {
  id          Int       @id @default(autoincrement())
  activities  String    @default("")
  createdAt   DateTime  @default(now())
  feedingTime Int       @default(0) // 0 - 3
  feedingAmt  String    @default("Nothing") // All, Some, Nothing 
  napStart    DateTime?
  napEnd      DateTime?
  note        String    @default("") // additional note
  sentAt      DateTime?

  dog      Dog?    @relation("DiaryNoteDogRelation", fields: [dogId], references: [id])
  dogId    Int?
  center   Center? @relation("DiaryNoteCenterRelation", fields: [centerId], references: [id])
  centerId Int?
}

model DiaryPhoto {
  id        Int       @id @default(autoincrement())
  pictures  File[]    @relation("DiaryPhotoFileRelation")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  dog      Dog?    @relation("DiaryPhotoDogRelation", fields: [dogId], references: [id])
  dogId    Int?
  center   Center? @relation("DiaryPhotoCenterRelation", fields: [centerId], references: [id])
  centerId Int?
}

model File {
  id        Int      @id @default(autoincrement())
  fileKey   String   @unique
  fileURL   String
  createdAt DateTime @default(now())

  center       Center?     @relation("CenterFileRelation", fields: [centerId], references: [id])
  centerId     Int?
  diaryPhoto   DiaryPhoto? @relation("DiaryPhotoFileRelation", fields: [diaryPhotoId], references: [id])
  diaryPhotoId Int?
  dog          Dog?        @relation("FacefileRelation", fields: [dogId], references: [id])
  dogId        Int?
}

// enum ReservationStatus {
//   PENDDING
//   ACCEPTED
//   DECLINED
// }
model Reservation {
  id        Int      @id @default(autoincrement())
  dog       Dog      @relation("ReservationDogRelation", fields: [dogId], references: [id])
  dogId     Int
  date      DateTime @default(now())
  status    String   @default("PENDDING")
  createdAt DateTime @default(now())
  center    Center   @relation("ReservationCenterRelation", fields: [centerId], references: [id])
  centerId  Int
}
